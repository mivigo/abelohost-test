{
    "name": "abelohost/blog",
    "description": "Simple PHP Smarty Blog",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "psr/container": "^2.0",
        "psr/log": "^3.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-server-handler": "^1.0",
        "smarty/smarty": "^4.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Controllers\\": "Controllers/",
            "App\\Models\\": "Models/",
            "App\\Helpers\\": "helpers/",
            "Database\\Migrations\\": "migrations/",
            "Database\\Seeders\\": "seeders/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
